POSTGRES_DB=jobagent
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://jobagent:CHANGE_ME_STRONG_PASSWORD@postgres:5432/jobagent

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_MIN_16_CHARS
MINIO_BUCKET=job-agent-private
MINIO_SECURE=false

API_PORT=8000
FRONTEND_PORT=3000

# Shared secret for API access. The dashboard forwards it server-side;
# never expose it with a NEXT_PUBLIC_ variable.
API_KEY=CHANGE_ME_LONG_RANDOM
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Mask e-mail/phone/name values in logs.
LOG_REDACT_PII=true

# Deployment environment: dev | prod. In prod, weak default secrets are rejected at startup.
ENV=dev

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 0-100. 95 çok katı; önce 75-85 ile deneyin.
MIN_MATCH_SCORE=80
AUTOMATION_MODE=PREPARE_APPLICATION
AUTO_SUBMIT=false

MAX_APPLICATIONS_PER_DAY=20
MAX_APPLICATIONS_PER_HOUR=5
BROWSER_HEADLESS=true

PROFILE_PATH=/app/profile/profile.yaml
PREFERENCES_PATH=/app/profile/preferences.yaml
MASTER_CV_PATH=/app/profile/master_cv.pdf

WORKABLE_ENABLED=true
WORKABLE_PUBLIC_DISCOVERY_ENABLED=true

LOG_LEVEL=INFO
