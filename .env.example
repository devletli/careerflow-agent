POSTGRES_DB=jobagent
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=            # zorunlu, bos birakma
# DATABASE_URL compose icinde yukaridaki degiskenlerden turetilir (x-db-url);
# .env dosyasina elle DATABASE_URL yazma.

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=             # zorunlu
MINIO_SECRET_KEY=             # zorunlu (en az 16 karakter)
MINIO_BUCKET=job-agent-private
MINIO_SECURE=false

API_PORT=8000
FRONTEND_PORT=3000
# Dashboard language: en | tr (default locale comes from this setting).
DASHBOARD_LOCALE=en

# Shared secret for API access. The dashboard forwards it server-side;
# never expose it with a NEXT_PUBLIC_ variable.
API_KEY=                      # zorunlu (dashboard->API)
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Mask e-mail/phone/name values in logs.
LOG_REDACT_PII=true
# Log format: json (varsayilan, correlation_id'li) | text (yalnizca gelistirme).
LOG_FORMAT=json

# Deployment environment: dev | prod. In prod, weak default secrets are rejected at startup.
ENV=dev

LLM_PROVIDER=gemini
LLM_MODEL=                    # acilista dogrulanir; bos birakilirsa LLM aciklamasi kapali, skor deterministik devam eder
GEMINI_API_KEY=
# Asagidaki anahtarlar yalnizca ilgili saglayici secilirse kullanilir
# (saglayici soyutlamasi: shared/llm/client.py LLMClient).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 0-100. Golden-set ile kalibre edildi: 90'da 25/25 dogru
# (85'te 23/25, 80'de 20/25). REVIEW bandi [T-10, T) otomatik isler.
MIN_MATCH_SCORE=90
AUTOMATION_MODE=PREPARE_APPLICATION
AUTO_SUBMIT=false

MAX_APPLICATIONS_PER_DAY=20
MAX_APPLICATIONS_PER_HOUR=5
BROWSER_HEADLESS=true

PROFILE_PATH=/app/profile/profile.yaml
PREFERENCES_PATH=/app/profile/preferences.yaml
MASTER_CV_PATH=/app/profile/master_cv.pdf

# Discovery connector bayraklari (job-discovery acilista aktif olanlari loglar).
WORKABLE_ENABLED=true
GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
ASHBY_ENABLED=true
SMARTRECRUITERS_ENABLED=true
BUNDESAGENTUR_ENABLED=true
ARBEITNOW_ENABLED=true

# Faz 1: kesif/listeleme sinirlari (koda gomulu degil). 0 = sinirsiz YASAK (validator reddeder).
DISCOVERY_MAX_JOBS_PER_SOURCE=3000
DISCOVERY_MAX_PAGES_PER_SOURCE=60
DISCOVERY_PAGE_DELAY_SECONDS=1.0
DISCOVERY_DETAIL_CONCURRENCY=4
DISCOVERY_TIME_BUDGET_SECONDS=900
LLM_EXPLAIN_MAX_PER_RUN=50
JOBS_PAGE_SIZE=100
JOBS_STALE_AFTER_DAYS=30

LOG_LEVEL=INFO
